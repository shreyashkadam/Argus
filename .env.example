# Required — OpenRouter API key (for Grok-4.1-fast and other models)
OPENROUTER_API_KEY=

# Required — Tavily API key for web search tool
TAVILY_API_KEY=

# Optional — Redis URL for caching scraped content and rate limiting
# When not set, caching and rate limiting are disabled (app works without Redis)
# REDIS_URL=redis://localhost:6379

# Optional — Rate limits (requests per 60s window). Defaults shown.
# TAVILY_RATE_LIMIT=20
# JINA_RATE_LIMIT=15
